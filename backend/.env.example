# DIGI-TRON Monitor - Servidor Central
# Copie este arquivo para .env no ambiente de produção

APP_NAME="DIGI-TRON Monitor Central Server"
ENVIRONMENT="production"
DEBUG="false"

# Endereço de escuta do servidor
SERVER_HOST="0.0.0.0"
SERVER_PORT=8000

# Banco de dados:
# Para desenvolvimento local (SQLite):
DATABASE_URL="sqlite:///./digitron_monitor.db"

# Para produção corporativa (PostgreSQL):
# DATABASE_URL="postgresql://digitron_user:SenhaForteAqui2026!@localhost:5432/digitron_monitor"

# Chave secreta de criptografia JWT (altere em produção com openssl rand -hex 32)
SECRET_KEY="digitron_super_secret_corporate_key_change_in_production_2026"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Regras de Monitoramento
HEARTBEAT_TIMEOUT_SECONDS=90
ALERT_CPU_THRESHOLD_PCT=90.0
ALERT_RAM_THRESHOLD_PCT=90.0
ALERT_DISK_THRESHOLD_PCT=90.0
